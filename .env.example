# Remote Ollama — set this to the remote host URL in CI/integration
OLLAMA_HOST=http://localhost:11434

# Model assignments — 4-model stack (no llama3.2)
MODEL_EMBED=nomic-embed-text:latest
MODEL_REASON=qwen3:14b
MODEL_SUMMARY=gemma4:e4b
# MODEL_FAST == MODEL_REASON disables the timeout-fallback path (we don't use llama3.2)
MODEL_FAST=qwen3:14b
MODEL_VISION=llava:7b

# ── Multi-provider LLM fleet (v4/v6) ─────────────────────────────────────────
# Route any role to a hosted, OpenAI-compatible provider instead of Ollama.
# Default "ollama" everywhere → fully local, no keys needed. A role falls back
# to Ollama automatically if its provider key/model is unset.
#
# Providers: ollama | groq | github | gemini | openai | anthropic | xai
#            | openrouter | custom | nvidia
#
# BRING YOUR OWN MODEL — pick a provider per role, set its key, run. Examples:
#   PROVIDER_REASON=anthropic  ANTHROPIC_API_KEY=sk-ant-…      # Claude as the reasoner
#   PROVIDER_REASON=openai     OPENAI_API_KEY=sk-…             # GPT as the reasoner
#   PROVIDER_FAST=groq         GROQ_API_KEY=gsk_…              # LPU-fast open weights
#   PROVIDER_SUMMARY=xai       XAI_API_KEY=xai-…               # Grok as summariser
#   PROVIDER_REASON=openrouter OPENROUTER_API_KEY=sk-or-…      # 100+ OSS models, one key
#   PROVIDER_REASON=custom     CUSTOM_BASE_URL=http://localhost:8001/v1 CUSTOM_MODEL=…
#                              # ^ any OpenAI-compatible gateway: vLLM, LM Studio,
#                              #   llama.cpp server, Together, Fireworks, DeepSeek, Mistral…
#
# FULLY HOSTED VIA NVIDIA (no local GPU/Ollama needed — build.nvidia.com free tier):
#   PROVIDER_SUMMARY=nvidia
#   PROVIDER_REASON=nvidia
#   PROVIDER_FAST=nvidia
#   PROVIDER_SOLVER=nvidia
#   PROVIDER_EMBED=nvidia
#   NVIDIA_API_KEY=nvapi-…
#   (one text model serves every text role; embeddings use NVIDIA_EMBED_MODEL)
PROVIDER_SUMMARY=ollama
PROVIDER_REASON=ollama
PROVIDER_FAST=ollama
PROVIDER_SOLVER=ollama
# Embeddings: ollama | gemini | openai | custom | nvidia (others have no embeddings endpoint).
PROVIDER_EMBED=ollama
PROVIDER_VISION=ollama

# SECRETS — put REAL keys only in your local .env (gitignored). NEVER commit them.
# Rotate any key that has been shared in chat / screenshots.
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
GOOGLE_GENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_API_KEY=
NVIDIA_API_KEY=

# Provider model names (override as desired).
GROQ_MODEL=llama-3.3-70b-versatile
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=text-embedding-004
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-sonnet-5
XAI_MODEL=grok-4
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
CUSTOM_MODEL=
CUSTOM_EMBED_MODEL=
# NVIDIA (build.nvidia.com). One text model serves every text role.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# nv-embedqa* needs input_type; set "" for symmetric embedders like baai/bge-m3.
NVIDIA_EMBED_INPUT_TYPE=query

# Vision models (for PROVIDER_VISION). Flagship chat models are already
# multimodal; empty → that provider's vision falls back to Ollama.
GROQ_VISION_MODEL=
GITHUB_MODELS_VISION_MODEL=openai/gpt-4.1-mini
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-5
XAI_VISION_MODEL=
OPENROUTER_VISION_MODEL=
CUSTOM_VISION_MODEL=

# Provider base URLs (OpenAI-compatible gateways; override only if one moves).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
XAI_BASE_URL=https://api.x.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# For local gateways: vLLM → http://localhost:8001/v1, LM Studio → http://localhost:1234/v1
CUSTOM_BASE_URL=

# Domain-specialized STEM embedder (off by default; requires `ollama pull bge-m3`
# + re-ingest to populate the separate STEM collection).
MODEL_EMBED_STEM=bge-m3
EMBED_STEM_ENABLED=false
# Reasoning specialist (VibeThinker) — routed to ADAPTIVELY for quantitative questions
# (maths / economics / science / engineering). Set empty to disable routing.
MODEL_SOLVER=vibethinker:3b

# Adaptive model routing (VibeThinker)
ROUTE_SOLVER_ENABLED=true
ROUTE_SOLVER_LLM_FALLBACK=false
SOLVER_TEMPERATURE=0.6
INGEST_DOMAIN_TAGGING=true

# Privacy redaction — strip secrets/PII from raw sources before ingest
INGEST_REDACT_SECRETS=true
INGEST_REDACT_EMAILS=false

# Agentic ingestion — adaptive chunk size/overlap from document structure.
# Heuristic is cheap (on by default); LLM refinement adds one gemma call per doc.
INGEST_AGENTIC_PLANNING=true
INGEST_PLANNING_LLM=false

# Multimodal knowledge graph (Phase 1) — persist tables/images/code/formulas as
# media nodes linked to entities. Off by default (populating requires re-ingest).
GRAPH_MULTIMODAL_NODES=false

# ── Best-of-best RAG package (v5) — all on by default ────────────────────────
# Small-to-big: rerank/synthesise the matched sub-chunks, not page[:4000].
QUERY_CHUNK_CONTEXT=true
# Anti-feedback-loop: machine-written pages score ×this at rerank (1.0 disables).
RETRIEVAL_SYNTH_DOWNWEIGHT=0.85
# Lost-in-the-middle: ends-load synthesis context (best first, runner-up last).
QUERY_LITM_REORDER=true
# NLI-lite claim verification: one batched judge call per answer.
QUERY_CLAIM_VERIFY=true
# Semantic answer cache: embed the question and short-circuit near-duplicates
# (cosine ≥ threshold) with a stored answer. Complements the procedural EXACT hash.
# OFF by default — serving cached answers is a behaviour change, so opt in.
QUERY_ANSWER_CACHE=false
ANSWER_CACHE_SIM_THRESHOLD=0.95
ANSWER_CACHE_TTL_DAYS=7
ANSWER_CACHE_MAX_ENTRIES=500
ANSWER_CACHE_MIN_CONFIDENCE=0.60
# Staleness guard: re-answer instead of serving a cached hit if any page it cited is
# gone (archived/rejected/superseded). Keeps the cache safe under a loose threshold.
ANSWER_CACHE_VERIFY_PAGES=true
# Doc2Query: index the questions each doc answers as <pid>#hq.
INGEST_DOC2QUERY=true
# RAPTOR-lite weekly topic overview pages.
JOB_BUILD_TOPICS_ENABLED=true
TOPICS_MIN_CLUSTER=3
TOPICS_MAX=12
TOPICS_SIM_THRESHOLD=0.62

# ── Review Autopilot — evidence-grounded auto-verification of staged pages ───
# A judge re-reads each staged page AGAINST its original source (+ entity-
# grounding cross-check; borderline cases get a second judge vote).
# composite ≥ accept → auto-publish · ≤ reject → auto-archive (reversible)
# · in between → annotated and left for human review.
REVIEW_AUTOPILOT_ENABLED=true       # inline pass right after ingest
JOB_REVIEW_AUTOPILOT_ENABLED=true   # daily 04:30 UTC backlog sweep
REVIEW_ACCEPT_THRESHOLD=0.70
REVIEW_REJECT_THRESHOLD=0.30
REVIEW_SECOND_OPINION=true
REVIEW_AUTOPILOT_MAX_PAGES=25

# ── Profile / schema contract ────────────────────────────────────────────────
# Runtime-enforced page-frontmatter contract (allowed kinds/domains, required
# fields, confidence bounds, entity/relation vocabularies). off | warn | strict.
# "warn" logs + audits violations but still writes; "strict" raises so ingest routes
# the offending page to review. PROFILE_PATH overrides the built-in default (JSON).
PROFILE_ENFORCEMENT=warn
PROFILE_PATH=

# ── Feedback curator ─────────────────────────────────────────────────────────
# Capture high-signal user corrections/preferences/approvals as memory candidates
# (generic acks dropped). Promotion → curated page / active preference / page
# reinforcement. Promoted preferences are injected into synthesis prompts.
FEEDBACK_ENABLED=true
FEEDBACK_AUTO_PROMOTE=false
FEEDBACK_INJECT_PREFERENCES=true
FEEDBACK_MAX_PREFERENCES=8

# Ingest / retrieval tuning
CONFIDENCE_THRESHOLD=0.60
PDF_CHUNK_PAGES=3
INGEST_OVERLAP=200
# 1 = strictly sequential; avoids Ollama model-swap thrashing
MAX_CONCURRENT_LLM_REQ=1

# Paths (relative to repo root)
WIKI_DIR=wiki
RAW_DIR=wiki/raw
DATA_DIR=data
LOGS_DIR=logs

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Timeouts (seconds) — generous because cold-load of gemma4/qwen3 can take 30-60s
LLM_TIMEOUT=600
LLM_FAST_TIMEOUT=120
